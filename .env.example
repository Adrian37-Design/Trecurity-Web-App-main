# ============================================================
# Trecurity Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env or .env.production to version control.
# ============================================================

# Database Configuration
DATABASE_URL=mysql://root:your_db_password@localhost:3306/trecurity

# Security Tokens
TOKEN_SECRET=your_token_secret_here
NUXT_SECRET=your_nuxt_secret_here

# JWT Secrets
NUXT_JWT_APP_TOKEN_SECRET=your_jwt_app_secret_here
NUXT_JWT_CONTROLLER_TOKEN_SECRET=your_jwt_controller_secret_here
NUXT_PUBLIC_JWT_APP_TOKEN_SECRET=your_jwt_public_app_secret_here
NUXT_PUBLIC_JWT_OTP_TOKEN_SECRET=your_jwt_otp_secret_here

# Site Configuration
NUXT_PUBLIC_SITE_URL=https://yourdomain.com

# reCAPTCHA Keys (get from https://www.google.com/recaptcha/admin)
NUXT_PUBLIC_RECAPTCHA_CLIENT_SITE_KEY=your_recaptcha_site_key
NUXT_RECAPTCHA_SERVER_SITE_KEY=your_recaptcha_secret_key

# Sentry (leave as 'disabled' if not using Sentry)
SENTRY_AUTH_TOKEN=disabled

# SMTP Configuration (Email)
SMTP_HOST=mail.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=info@yourdomain.com
SMTP_PASSWORD=your_smtp_password

# Node Environment
NODE_ENV=production
PORT=3000
